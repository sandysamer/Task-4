// Simulated database of products
const products = {
  1: "Laptop",
  2: "Phone",
  3: "Tablet"
};

/**
 * Function to fetch a product by its ID using a Promise.
 * @param {number} id - The ID of the product to search for.
 * @returns {Promise<string>} - Resolves with the product name or rejects with an error message.
 */
function getProduct(id) {
  // Create and return a new Promise
  return new Promise((resolve, reject) => {
    // Access the product using object key lookup
    const productName = products[id];

    // Check if the product exists in the simulated database
    if (productName) {
      // Existing ID -> Resolve with the product name
      resolve(productName);
    } else {
      // Invalid ID -> Reject the Promise with an error message
      reject(`Product with ID ${id} not found.`);
    }
  });
}

// --- Example Usage ---

// Example 1: Valid ID (Resolves successfully)
getProduct(2)
  .then((product) => console.log(product)) // Output: Phone
  .catch((error) => console.log(error));

// Example 2: Invalid ID (Rejects with error)
getProduct(99)
  .then((product) => console.log(product))
  .catch((error) => console.log(error)); // Output: Product with ID 99 not found.
